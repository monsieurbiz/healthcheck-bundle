{
    "name": "monsieurbiz/healthcheck-bundle",
    "description": "Symfony bundle providing a /healthcheck endpoint that dispatches a HealthcheckEvent.",
    "type": "symfony-bundle",
    "license": "MIT",
    "require": {
        "php": ">=8.0.2",
        "symfony/dependency-injection": "^6.0 || ^7.0 || ^8.0",
        "symfony/event-dispatcher-contracts": "^2.5 || ^3.0",
        "symfony/http-foundation": "^6.0 || ^7.0 || ^8.0",
        "symfony/http-kernel": "^6.0 || ^7.0 || ^8.0",
        "symfony/routing": "^6.0 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6 || ^10.5 || ^11.5",
        "symfony/framework-bundle": "^6.0 || ^7.0 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "MonsieurBiz\\HealthcheckBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MonsieurBiz\\HealthcheckBundle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
